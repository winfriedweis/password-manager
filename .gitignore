# ============================================
# NUP - .gitignore
# ============================================

# ============================================
# SENSIBLE DATEN - NIEMALS COMMITTEN!
# ============================================

# Datenbank-Konfiguration mit Credentials
database.properties
*.properties
!pom.properties

# Lokale NUP-Konfiguration (enthält DB-Passwörter)
.nup/
**/.nup/

# Environment-Variablen
.env
.env.local
.env.*.local
*.env

# Secrets & Credentials
secrets/
credentials/
*.pem
*.key
*.crt
*.p12
*.jks
*.keystore
*.truststore

# ============================================
# BUILD OUTPUTS
# ============================================

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle (falls später verwendet)
.gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Compiled files
*.class
*.jar
*.war
*.ear
*.nar

# ============================================
# IDE - IntelliJ IDEA
# ============================================

# Komplettes .idea Verzeichnis (enthält oft lokale Pfade)
.idea/

# IntelliJ Projekt-Dateien
*.iws
*.iml
*.ipr

# IntelliJ Caches
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries
.idea/**/shelf
.idea/**/contentModel.xml
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml
.idea/**/sqlDataSources.xml
.idea/**/dynamic.xml
.idea/**/uiDesigner.xml
.idea/**/dbnavigator.xml

# ============================================
# IDE - Eclipse
# ============================================

.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/

# ============================================
# IDE - NetBeans
# ============================================

/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# ============================================
# IDE - VS Code
# ============================================

.vscode/
*.code-workspace

# ============================================
# LOGS & TEMP FILES
# ============================================

# Log-Dateien
*.log
logs/
log/
*.log.*

# Temporäre Dateien
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Crash Reports
hs_err_pid*
replay_pid*

# ============================================
# BETRIEBSSYSTEM
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================
# JAVA SPEZIFISCH
# ============================================

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JNI
*.dll
*.so
*.dylib

# ============================================
# TESTEN
# ============================================

# Test Reports
test-output/
surefire-reports/
failsafe-reports/

# Code Coverage
*.exec
jacoco.exec
coverage/
.coverage

# ============================================
# DOKUMENTATION (generiert)
# ============================================

# JavaDoc
docs/javadoc/
apidocs/

# ============================================
# LOKALE ENTWICKLUNG
# ============================================

# Lokale Overrides
local.properties
*.local
*.local.*

# Backup-Dateien
*.backup
*.old

# ============================================
# SPEZIFISCH FÜR DIESES PROJEKT
# ============================================

# Screenshots Ordner (falls leer oder Platzhalter)
docs/screenshots/*.png
!docs/screenshots/.gitkeep

# Alte Anleitung (falls nicht mehr benötigt)
# NUP-Anleitung.md
